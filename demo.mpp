define number getSquare()
start
    doreturn 9 * 9;
finish

define nothing printBanner()
start
    show("-------------------");
finish

define number doubleIt()
start
    doreturn g_num * 2;
finish

// Iterative factorial using repeat + shared var g_num
define number factorial()
start
    number result = 1;
    number fi = 1;
    repeat (fi <= g_num) start
        result = result * fi;
        fi = fi + 1;
    finish
    doreturn result;
finish

// Returns 1 if g_num is prime, 0 otherwise
define number isPrime()
start
    when (g_num < 2) start
        doreturn 0;
    finish
    number pd = 2;
    repeat (pd * pd <= g_num) start
        when (g_num / pd * pd == g_num) start
            doreturn 0;
        finish
        pd = pd + 1;
    finish
    doreturn 1;
finish

// ── Main entry point 
define nothing main()
start

    // TEST 1: number (int) arithmetic

    show(" TEST 1: number variables & arithmetic ");
    number a = 10;
    number b = 3;
    show(a);            // 10
    show(b);            // 3
    show(a + b);        // 13
    show(a - b);        // 7
    show(a * b);        // 30
    show(a / b);        // 3
    show(b * b);        // 9

    
    // TEST 2: decimal (float) arithmetic
    
    show(" TEST 2: decimal variables ");
    decimal pi = 3.14;
    decimal r  = 2.5;
    show(pi);           // 3.14
    show(r);            // 2.5
    show(pi * r * r);   // 19.625

    
    // TEST 3: letter (char) variable

    show(" TEST 3: letter variable ");
    letter ch = 'A';
    show(ch);           // A
    letter z  = 'z';
    show(z);            // z

    // TEST 4: yes / no boolean literals
   
    show(" TEST 4: yes/no boolean literals ");
    number t = yes;
    number f = no;
    show(t);            // 1
    show(f);            // 0
    show(yes);          // 1
    show(no);           // 0

    
    // TEST 5: All comparison and equality operators
    
    show(" TEST 5: comparison operators ");
    show(10 > 5);       // 1
    show(3 < 2);        // 0
    show(5 >= 5);       // 1
    show(4 <= 3);       // 0
    show(7 == 7);       // 1
    show(7 != 8);       // 1
    show(7 == 8);       // 0

    
    // TEST 6: when / otherwise if-else chain
    
    show(" TEST 6: when / otherwise ");
    number val = 5;
    when (val > 0) start
        show("Positive");           // Positive
    finish

    when (val > 10) start
        show("big");
    finish otherwise start
        show("not big");            // not big
    finish

    number score = 75;
    when (score >= 90) start
        show("Grade: A");
    finish otherwise when (score >= 80) start
        show("Grade: B");
    finish otherwise when (score >= 70) start
        show("Grade: C");           // Grade: C
    finish otherwise start
        show("Grade: F");
    finish

    
    // TEST 7: repeat (while) loop
    
    show(" TEST 7: repeat (while loop) ");
    number wi = 1;
    repeat (wi <= 5) start
        show(wi);       // 1 2 3 4 5
        wi = wi + 1;
    finish

    
    // TEST 8: loop (for loop)
   
    show("=== TEST 8: loop (for loop) ===");
    loop (number j = 0; j < 5; j = j + 1) start
        show(j);        // 0 1 2 3 4
    finish

    
    // TEST 9: stop (break) inside repeat
   
    show(" TEST 9: stop (break) ");
    number k = 0;
    repeat (k < 10) start
        when (k == 4) start
            stop;
        finish
        show(k);        // 0 1 2 3
        k = k + 1;
    finish

    
    // TEST 10: skip (continue) inside loop
    
    show(" TEST 10: skip (continue) ");
    loop (number m = 0; m < 6; m = m + 1) start
        when (m == 3) start
            skip;
        finish
        show(m);        // 0 1 2 4 5
    finish

    
    // TEST 11: Arrays – declaration, assignment, access
    
    show(" TEST 11: arrays ");
    number arr[5];
    arr[0] = 100;
    arr[1] = 200;
    arr[2] = 300;
    arr[3] = 400;
    arr[4] = 500;
    show(arr[0]);           // 100
    show(arr[2]);           // 300
    show(arr[4]);           // 500
    show(arr[1] + arr[2]);  // 500

    
    // TEST 12: loop filling array with index variable
    
    show(" TEST 12: loop writing to array via index var ");
    number brr[5];
    loop (number li = 0; li < 5; li = li + 1) start
        brr[li] = 66;
    finish
    show(brr[0]);   // 66
    show(brr[1]);   // 66
    show(brr[2]);   // 66
    show(brr[3]);   // 66
    show(brr[4]);   // 66

    // partial fill then check zero-init
    number crr[4];
    crr[0] = 10;
    crr[1] = 20;
    // crr[2] and crr[3] are 0 by calloc
    show(crr[0]);   // 10
    show(crr[1]);   // 20
    show(crr[2]);   // 0
    show(crr[3]);   // 0

    
    // TEST 13: define + doreturn (value-returning function)
    
    show(" TEST 13: define + doreturn ");
    number sq = getSquare();
    show(sq);           // 81
    show(getSquare());  // 81

    
    // TEST 14: define nothing (void function)
   
    show(" TEST 14: define nothing (void func) ");
    printBanner();      

    // TEST 15: function using shared global variable
    
    show(" TEST 15: function with shared variable ");
    number g_num = 7;
    show(doubleIt());   // 14
    g_num = 4;
    show(doubleIt());   // 8

    
    // TEST 16: factorial via repeat inside function
    
    show(" TEST 16: factorial function ");
    g_num = 5;
    show(factorial());  // 120
    g_num = 6;
    show(factorial());  // 720

    
    // TEST 17: Prime checker function
    
    show(" TEST 17: prime checker ");
    g_num = 7;
    show(isPrime());    // 1 (7 is prime)
    g_num = 9;
    show(isPrime());    // 0 (9 = 3x3)
    g_num = 13;
    show(isPrime());    // 1

    
    // TEST 18: Nested when inside loop
    
    show(" TEST 18: nested when inside loop ");
    loop (number nn = 1; nn <= 10; nn = nn + 1) start
        // even check: n == (n/2)*2
        when (nn == nn / 2 * 2) start
            show(nn);   // 2 4 6 8 10
        finish
    finish

    // TEST 19: Uninitialized variable defaults to 0
    
    show(" TEST 19: uninitialized variable = 0 ");
    number uninit;
    show(uninit);       // 0

    
    // TEST 20: Negative numbers (UMINUS)
    
    show(" TEST 20: negative numbers ");
    number neg = -5;
    show(neg);          // -5
    show(neg * -1);     // 5
    show(-10 + 3);      // -7

    
    // TEST 21: Operator precedence
    
    show("=== TEST 21: expression precedence ===");
    show(2 + 3 * 4);        // 14
    show((2 + 3) * 4);      // 20
    show(10 - 2 * 3 + 1);   // 5
    show(10 / 2 + 3);       // 8

    
    // TEST 22: msin, mcos, mtan  (arguments in radians)
    //   sin(0) = 0,  cos(0) = 1,  tan(0) = 0
    //   sin(pi/2) ≈ 1
    
    show("=== TEST 22: trig functions (radians) ===");
    show(msin(0));          // 0
    show(mcos(0));          // 1
    show(mtan(0));          // 0
    decimal halfpi = 1.5708;
    show(msin(halfpi));     // ~1  (prints 1)
    show(mcos(halfpi));     // ~0  (prints a tiny float)

   
    // TEST 23: msqrt
    
    show("=== TEST 23: msqrt ===");
    show(msqrt(0));         // 0
    show(msqrt(1));         // 1
    show(msqrt(4));         // 2
    show(msqrt(9));         // 3
    show(msqrt(2));         // 1.41421

    
    // TEST 24: mlog (base 10)
    
    show("=== TEST 24: mlog (base 10) ===");
    show(mlog(1));          // 0
    show(mlog(10));         // 1
    show(mlog(100));        // 2
    show(mlog(1000));       // 3

    
    // TEST 25: mpow(base, exp)
    
    show("=== TEST 25: mpow ===");
    show(mpow(2, 0));       // 1
    show(mpow(2, 1));       // 2
    show(mpow(2, 10));      // 1024
    show(mpow(3, 3));       // 27
    show(mpow(5, 3));       // 125
    show(mpow(2, -1));      // 0.5

    
    // TEST 26: Math functions in complex expressions
    
    show("=== TEST 26: math in expressions ===");
    // Pythagorean: sqrt(3^2 + 4^2) = 5
    show(msqrt(mpow(3, 2) + mpow(4, 2)));   // 5
    // log(10^3) = 3
    show(mlog(mpow(10, 3)));                 // 3
    // 2^msqrt(4) = 2^2 = 4
    show(mpow(2, msqrt(4)));                 // 4

    
    // TEST 27: Math edge cases
    
    show("=== TEST 27: math edge cases ===");
    show(msqrt(0));         // 0  (boundary)
    show(mpow(0, 0));       // 1  (by C convention)
    show(mlog(1));          // 0  (log10(1)=0)
    show(mpow(1, 999));     // 1  (1^anything = 1)

    
    // TEST 28: Array with loop – mixed writes and reads
    
    show("=== TEST 28: array sum via loop ===");
    number sums[5];
    loop (number si = 0; si < 5; si = si + 1) start
        sums[si] = si * si;   // 0 1 4 9 16
    finish
    number total = 0;
    loop (number ri = 0; ri < 5; ri = ri + 1) start
        total = total + sums[ri];
    finish
    show(total);            // 30  (0+1+4+9+16)

    
    // TEST 29: stop inside nested loops (break outer)
    
    show("=== TEST 29: stop in nested loop ===");
    number found = 0;
    loop (number oi = 0; oi < 5; oi = oi + 1) start
        loop (number ii = 0; ii < 5; ii = ii + 1) start
            when (oi * 5 + ii == 7) start
                found = oi * 10 + ii;
                stop;       // breaks inner loop only
            finish
        finish
        when (found > 0) start
            stop;           // breaks outer loop
        finish
    finish
    show(found);            // 12  (oi=1, ii=2 -> 1*10+2)

    
    // TEST 30: String output
    
    show("=== TEST 30: string literals ===");
    show("Hello, M++ World!");
    show("All tests passed!");

    
    // TEST 31: Stack — basic operations
    
    show("=== TEST 31: stack basic operations ===");

    stack st;

    // isEmpty on a fresh stack
    show(sisempty st);      // 1

    // push three values
    spush st 10;
    spush st 20;
    spush st 30;

    // size after three pushes
    show(ssize st);         // 3

    // isEmpty now false
    show(sisempty st);      // 0

    // peek does NOT remove the top
    show(speek st);         // 30
    show(ssize st);         // 3  (still 3)

    // pop into a variable
    spop st topVal;
    show(topVal);           // 30
    show(ssize st);         // 2

    // pop and discard
    spop st;
    show(ssize st);         // 1

    // last remaining element
    show(speek st);         // 10

    // pop the last one
    spop st;
    show(sisempty st);      // 1  (empty again)

    
    // TEST 32: Stack — LIFO order (reverse sequence)
    
    show("=== TEST 32: stack LIFO / reverse ===");

    stack rev;
    loop (number pi = 1; pi <= 5; pi = pi + 1) start
        spush rev pi;       // push 1 2 3 4 5
    finish

    // popping gives 5 4 3 2 1
    repeat (sisempty rev == no) start
        spop rev rv;
        show(rv);           // 5  4  3  2  1
    finish

    
    // TEST 33: Stack — spop used in expression
    
    show("=== TEST 33: stack spop in expression ===");

    stack exps;
    spush exps 7;
    spush exps 3;

    // use spop directly inside an arithmetic expression
    number diff = spop exps - spop exps;  // 3 - 7 = -4
    show(diff);             // -4

    show(sisempty exps);    // 1

 
    // TEST 34: Stack — conditional with sisempty / speek
    
    show("=== TEST 34: stack in conditions ===");

    stack conds;
    spush conds 42;

    when (sisempty conds == no) start
        show("stack not empty");    // stack not empty
    finish

    when (speek conds == 42) start
        show("top is 42");          // top is 42
    finish

    spop conds;

    when (sisempty conds) start
        show("stack is empty");     // stack is empty
    finish

   
    // TEST 35: Queue — basic operations
    
    show("=== TEST 35: queue basic operations ===");

    queue qu;

    // isEmpty on a fresh queue
    show(qisempty qu);      // 1

    // enqueue three values
    qenqueue qu 100;
    qenqueue qu 200;
    qenqueue qu 300;

    // size after three enqueues
    show(qsize qu);         // 3

    // isEmpty now false
    show(qisempty qu);      // 0

    // peek does NOT remove the front
    show(qpeek qu);         // 100
    show(qsize qu);         // 3  (still 3)

    // dequeue into a variable
    qdequeue qu frontVal;
    show(frontVal);         // 100
    show(qsize qu);         // 2

    // dequeue and discard
    qdequeue qu;
    show(qsize qu);         // 1

    // last remaining element
    show(qpeek qu);         // 300

    // dequeue the last one
    qdequeue qu;
    show(qisempty qu);      // 1  (empty again)

   
    // TEST 36: Queue — FIFO order
    
    show("=== TEST 36: queue FIFO order ===");

    queue fifo;
    loop (number qi = 1; qi <= 5; qi = qi + 1) start
        qenqueue fifo qi;   // enqueue 1 2 3 4 5
    finish

    // dequeuing gives 1 2 3 4 5  (same order)
    repeat (qisempty fifo == no) start
        qdequeue fifo fv;
        show(fv);           // 1  2  3  4  5
    finish

    
    // TEST 37: Queue — qdequeue used in expression
    
    show("=== TEST 37: queue qdequeue in expression ===");

    queue expq;
    qenqueue expq 8;
    qenqueue expq 2;

    // use qdequeue directly inside an arithmetic expression
    number qsum = qdequeue expq + qdequeue expq;  // 8 + 2 = 10
    show(qsum);             // 10

    show(qisempty expq);    // 1

    
    // TEST 38: Queue — conditional with qisempty / qpeek
    
    show("=== TEST 38: queue in conditions ===");

    queue condq;
    qenqueue condq 99;

    when (qisempty condq == no) start
        show("queue not empty");    // queue not empty
    finish

    when (qpeek condq == 99) start
        show("front is 99");        // front is 99
    finish

    qdequeue condq;

    when (qisempty condq) start
        show("queue is empty");     // queue is empty
    finish

    
    // TEST 39: Stack and Queue together — transfer elements
    //   Push 1..5 onto a stack, then pop into a queue.
    //   Stack reverses; queue then outputs in that reversed
    //   order, giving 5 4 3 2 1 from the queue.
   
    show("=== TEST 39: stack-to-queue transfer ===");

    stack src;
    queue dst;

    loop (number ti = 1; ti <= 5; ti = ti + 1) start
        spush src ti;       // stack: bottom→top = 1 2 3 4 5
    finish

    // pop each element from the stack into the queue
    repeat (sisempty src == no) start
        spop src tmp;
        qenqueue dst tmp;   // queue receives 5 4 3 2 1
    finish

    // drain the queue — must print 5 4 3 2 1
    repeat (qisempty dst == no) start
        qdequeue dst out;
        show(out);          // 5  4  3  2  1
    finish

    show(" TEST 40: ssize and speek in expressions ");

    stack calc;
    spush calc 4;
    spush calc 6;

    // ssize in arithmetic
    show(ssize calc * 10);      // 2 * 10 = 20

    // speek in arithmetic
    show(speek calc + 1);       // 6 + 1 = 7

    // speek in comparison
    when (speek calc > 5) start
        show("top > 5");        // top > 5
    finish

    spop calc;
    spop calc;
    show(ssize calc);           // 0

    
    // TEST 41: Queue — qsize and qpeek in expressions

    show("=== TEST 41: qsize and qpeek in expressions ===");

    queue qcalc;
    qenqueue qcalc 3;
    qenqueue qcalc 9;

    // qsize in arithmetic
    show(qsize qcalc * 5);      // 2 * 5 = 10

    // qpeek in arithmetic
    show(qpeek qcalc + 1);      // 3 + 1 = 4

    // qpeek in comparison
    when (qpeek qcalc < 5) start
        show("front < 5");      // front < 5
    finish

    qdequeue qcalc;
    qdequeue qcalc;
    show(qisempty qcalc);       // 1

finish
